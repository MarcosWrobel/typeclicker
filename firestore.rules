rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true && (
               request.auth.token.email == 'wrobel.marcos@gmail.com' ||
               request.auth.token.email == 'marcos.wrobel@escola.pr.gov.br'
             );
    }

    function isTeacher() {
      return isSignedIn() &&
             request.auth.token.email_verified == true && (
               isAdmin() || (
                 exists(/databases/$(database)/documents/system/settings) &&
                 'allowedTeachers' in get(/databases/$(database)/documents/system/settings).data &&
                 request.auth.token.email in get(/databases/$(database)/documents/system/settings).data.allowedTeachers
               )
             );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPlayerSave(data) {
      return data.keys().hasAll(['userId', 'saveState']) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.saveState is map;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['userId', 'nome', 'level', 'points']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.nome is string && data.nome.size() <= 100 &&
             data.level is number && data.level >= 1 && data.level <= 100 &&
             data.points is number && data.points >= 0 &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 32)) &&
             (!('cardFrame' in data) || (data.cardFrame is string && data.cardFrame.size() <= 64)) &&
             (!('apelido' in data) || (data.apelido is string && data.apelido.size() <= 100));
    }

    match /saves/{userId} {
      allow read, write: if isAdmin();
      allow get: if isValidId(userId) && isOwner(userId);
      allow create, update: if isValidId(userId) && isOwner(userId) && isValidPlayerSave(incoming()) && incoming().userId == request.auth.uid;
      allow delete: if isAdmin() || (isValidId(userId) && isOwner(userId));
    }

    match /leaderboard/{userId} {
      allow read: if isSignedIn();
      allow create, update: if !isAdmin() && !isTeacher() &&
                              isValidId(userId) &&
                              isOwner(userId) &&
                              incoming().turma != 'Professor' &&
                              incoming().get('isStaff', false) == false &&
                              isValidLeaderboardEntry(incoming()) &&
                              incoming().userId == request.auth.uid;
      allow delete: if isAdmin() || (isValidId(userId) && isOwner(userId));
    }

    match /system/settings {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (
        isSignedIn() &&
        request.auth.token.email_verified == true &&
        resource != null &&
        'allowedTeachers' in resource.data &&
        request.auth.token.email in resource.data.allowedTeachers &&
        !incoming().diff(resource.data).affectedKeys().hasAny(['allowedTeachers', 'testGrantsHistory', 'pendingTestGrants', 'testerEmails'])
      );
    }

    match /arena_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() ||
        isTeacher() ||
        (roomId != 'active_classroom_raid' && roomId != 'active_classroom_race' && incoming().createdBy == request.auth.uid)
      );
      allow delete: if isSignedIn() && (
        isAdmin() ||
        isTeacher() ||
        (resource != null && resource.data.createdBy == request.auth.uid)
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        isTeacher() ||
        (roomId == 'active_classroom_raid' && incoming().diff(resource.data).affectedKeys().hasOnly(['currentHp', 'totalDamageDealt', 'participants', 'status', 'mvp'])) ||
        (roomId == 'active_classroom_race' && incoming().diff(resource.data).affectedKeys().hasOnly(['participants', 'finishers', 'winner', 'status'])) ||
        (roomId != 'active_classroom_raid' && roomId != 'active_classroom_race' && (
          // Criador da sala
          resource.data.get('createdBy', '') == request.auth.uid ||
          // Desafiante já registrado
          (resource.data.get('player2', null) != null && resource.data.player2.uid == request.auth.uid) ||
          // Entrando na vaga livre: só pode alterar player2 e se registrar com o próprio uid
          (resource.data.get('player2', null) == null &&
           incoming().get('player2', null) != null &&
           incoming().player2.uid == request.auth.uid &&
           incoming().diff(resource.data).affectedKeys().hasOnly(['player2']))
        ))

      );
    }

    match /backups/{backupId} {
      allow read, write: if isAdmin();
    }
  }
}

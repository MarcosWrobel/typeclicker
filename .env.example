# Provedor do Banco de Dados ('firestore' ou 'supabase')
VITE_DB_PROVIDER=firestore

# Supabase (opcional se Firestore estiver ativo)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase / Firestore (opcional em Cloud Run com ADC nativo)
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=

# Servidor Express
PORT=3000
# Defina como true SOMENTE após habilitar Third-Party Auth (Firebase) no Supabase
# e aplicar supabase/migrations/secure_rls_firebase_jwt.sql
VITE_SUPABASE_FIREBASE_AUTH=false
